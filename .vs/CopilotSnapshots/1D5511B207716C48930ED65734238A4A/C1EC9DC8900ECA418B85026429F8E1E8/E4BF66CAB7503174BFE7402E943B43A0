* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #111827;
  color: #f3f4f6;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px;
  text-align: center;
}

h1 {
  margin-bottom: 8px;
}

.subtitle {
  margin-top: 0;
  color: #d1d5db;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: flex-start;
  background: #1f2937;
  padding: 16px;
  border-radius: 10px;
  margin-bottom: 20px;
  width: 100%;
}

.file-label {
  font-weight: 600;
  position: relative;
  z-index: 2;
  text-align: center;
}

.picker-area {
  position: relative;
  width: 100%;
  max-width: 500px;
  min-height: 120px;
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 6px;
}

#fileInput {
  position: relative;
  z-index: 2;
}

.drop-zone {
  position: absolute;
  inset: 0;
  padding: 12px;
  border: 2px dashed #4b5563;
  border-radius: 8px;
  text-align: center;
  color: #d1d5db;
  background: rgba(17, 24, 39, 0.45);
  display: grid;
  place-items: center;
  pointer-events: none;
  z-index: 1;
}

.drop-zone.active {
  border-color: #60a5fa;
  background: rgba(30, 58, 138, 0.6);
  color: #eff6ff;
}

.progress-container {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  max-width: 500px;
}

#processProgress {
  width: 100%;
  height: 20px;
  border: none;
  border-radius: 4px;
  background: #374151;
}

#processProgress::-webkit-progress-bar {
  background: #374151;
  border-radius: 4px;
}

#processProgress::-webkit-progress-value {
  background: #3b82f6;
  border-radius: 4px;
}

#processProgress::-moz-progress-bar {
  background: #3b82f6;
  border-radius: 4px;
}

#progressLabel {
  font-size: 0.85rem;
  color: #d1d5db;
  white-space: nowrap;
  min-width: 30px;
}

#processBtn {
  padding: 10px 14px;
  border: 0;
  border-radius: 8px;
  cursor: pointer;
  white-space: nowrap;
  align-self: flex-start;
}

#status {
  display: none;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 14px;
}

.card {
  background: #1f2937;
  border-radius: 10px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.preview-box {
  width: 100%;
  aspect-ratio: 1 / 1;
  border: 1px dashed #374151;
  border-radius: 8px;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: #0b1220;
}

.preview-box img {
  max-width: 100%;
  height: auto;
  image-rendering: auto;
}

.download-btn {
  display: inline-block;
  margin-top: 10px;
  background: #2563eb;
  color: #eff6ff;
  border: 0;
  border-radius: 8px;
  padding: 8px 12px;
  cursor: pointer;
}

.hidden {
  display: none;
}

.meta {
  margin: 8px 0 0;
  color: #d1d5db;
  font-size: 0.9rem;
}
